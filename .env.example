# Environment Variables for VibeLaunch

# ─── Supabase ──────────────────────────────────────────────────────────
# Your Supabase project URL (found in: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (found in: Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Prisma / Database ──────────────────────────────────────────────────
# Prisma connection pooling URL (found in: Supabase → Project Settings → Database → Connection string → Transaction pooler)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct URL for migrations (found in: Supabase → Project Settings → Database → Connection string → Direct connection)
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── Cron Job Security ─────────────────────────────────────────────────
# Random secret for securing cron endpoints (generate with: openssl rand -base64 32)
CRON_SECRET=your-random-secret-here

# ─── GitHub API (for data ingestion) ───────────────────────────────────
# GitHub Personal Access Token for higher rate limits on repo search
# Create at: https://github.com/settings/tokens → Fine-grained tokens → No special scopes needed for public repos
GITHUB_TOKEN=github_pat_your_token_here
