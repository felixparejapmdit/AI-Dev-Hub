// Prisma Schema for VibeLaunch - AI Dev Hub
// Targets: Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AIModel {
  id            String   @id @default(cuid())
  name          String   @unique
  provider      String
  type          ModelType @default(CLOUD)
  contextWindow Int
  description   String?
  releaseDate   DateTime?
  apiSlug       String?
  iconUrl       String?
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("ai_models")
}

model MCPServer {
  id             String    @id @default(cuid())
  name           String
  repoUrl        String    @unique
  installCommand String
  description    String?
  category       MCPCategory @default(UTILITY)
  author         String?
  stars          Int        @default(0)
  npmPackage     String?
  tags           String[]
  lastSyncedAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("mcp_servers")
}

model Skill {
  id             String      @id @default(cuid())
  title          String
  description    String?
  category       SkillCategory @default(GENERAL)
  systemPrompt   String      @db.Text
  tags           String[]
  author         String?
  useCount       Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("skills")
}

enum ModelType {
  CLOUD
  LOCAL
  HYBRID
}

enum MCPCategory {
  DATABASE
  FILESYSTEM
  WEB
  CODE
  COMMUNICATION
  AI
  UTILITY
  DEVTOOLS
}

enum SkillCategory {
  GENERAL
  CODING
  WRITING
  ANALYSIS
  DEVOPS
  RESEARCH
  CREATIVE
}
